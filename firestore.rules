rules_version = '2';

// กฎความปลอดภัยของฐานข้อมูล
// ลูกค้า: ส่งออเดอร์ใหม่ได้ (เฉพาะตอนร้านกดเปิดรับออเดอร์) และดูออเดอร์ที่ตัวเองรู้รหัสได้
// หน้าร้าน (บัญชี shop@loongjoke.app): ดูออเดอร์ทั้งหมด เปลี่ยนสถานะ กดเมนูหมด และกดเปิด/ปิดร้าน
service cloud.firestore {
  match /databases/{database}/documents {

    function isShop() {
      return request.auth != null && request.auth.token.email == 'shop@loongjoke.app';
    }

    // หน้าร้านไม่ได้กดปิดรับออเดอร์ (settings/shop.open != false) ยังไม่เคยกด = เปิด
    function isOpen() {
      let shop = /databases/$(database)/documents/settings/shop;
      return !exists(shop) || get(shop).data.open != false;
    }

    function isValidNewOrder(d) {
      return d.keys().hasOnly(['table', 'items', 'total', 'status', 'createdAt', 'updatedAt'])
        && d.table is int && d.table >= 1 && d.table <= 10
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.total is int && d.total > 0 && d.total <= 20000
        && d.status == 'new'
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if true;
      allow list: if isShop();
      allow create: if isOpen() && isValidNewOrder(request.resource.data);
      allow update: if isShop()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'making', 'done', 'cancelled'];
      allow delete: if false;
    }

    match /settings/soldOut {
      allow read: if true;
      allow write: if isShop();
    }

    match /settings/shop {
      allow read: if true;
      allow write: if isShop()
        && request.resource.data.keys().hasOnly(['open', 'updatedAt'])
        && request.resource.data.open is bool
        && request.resource.data.updatedAt == request.time;
    }
  }
}
